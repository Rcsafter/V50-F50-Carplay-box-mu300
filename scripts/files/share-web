#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""车内共享 · 网页端

- GET /            列表页
- GET /api/list    JSON 文件清单
- GET /f/<目录>/<文件>  文件本体，支持 Range 断点续传（视频可拖动进度条）
"""
import json
import os
import posixpath
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import quote, unquote, urlparse

ROOT = os.environ.get("SHARE_ROOT", "/mnt/mu300-disk/share")
PAGE = os.environ.get("SHARE_PAGE", "/www/share-app.html")
PORT = int(os.environ.get("SHARE_PORT", "8080"))
# 8443 是给 https 页面嵌 iframe 用的：https 页面不能加载 http 资源（混合内容会被浏览器拦掉），
# 所以共享必须也能用 TLS 提供。证书不存在就只跑明文端口。
PORT_TLS = int(os.environ.get("SHARE_PORT_TLS", "0") or "0")
CERT = os.environ.get("SHARE_CERT", "")
KEY = os.environ.get("SHARE_KEY", "")

VIDEO = {".mp4", ".m4v", ".mov", ".mkv", ".avi", ".ts", ".webm", ".flv", ".wmv"}
AUDIO = {".mp3", ".m4a", ".aac", ".flac", ".wav", ".ogg", ".opus", ".wma"}
IMAGE = {".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".heic"}
PLAIN = {".mp4", ".m4v", ".mov", ".webm", ".mp3", ".m4a", ".aac", ".wav",
         ".ogg", ".opus", ".jpg", ".jpeg", ".png", ".gif", ".webp"}

MIME = {
    ".mp4": "video/mp4", ".m4v": "video/mp4", ".mov": "video/quicktime",
    ".webm": "video/webm", ".mkv": "video/x-matroska", ".avi": "video/x-msvideo",
    ".ts": "video/mp2t", ".mp3": "audio/mpeg", ".m4a": "audio/mp4",
    ".aac": "audio/aac", ".flac": "audio/flac", ".wav": "audio/wav",
    ".ogg": "audio/ogg", ".opus": "audio/ogg", ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg", ".png": "image/png", ".gif": "image/gif",
    ".webp": "image/webp", ".html": "text/html; charset=utf-8",
    ".json": "application/json; charset=utf-8", ".txt": "text/plain; charset=utf-8",
}


def kind(ext):
    if ext in VIDEO:
        return "video"
    if ext in AUDIO:
        return "audio"
    if ext in IMAGE:
        return "image"
    return "file"


def listing():
    items = []
    try:
        tops = sorted(os.listdir(ROOT))
    except OSError:
        tops = []
    for top in tops:
        if top.startswith("."):
            continue
        td = os.path.join(ROOT, top)
        if not os.path.isdir(td):
            continue
        try:
            names = sorted(os.listdir(td))
        except OSError:
            continue
        for n in names:
            if n.startswith("."):
                continue
            p = os.path.join(td, n)
            try:
                st = os.stat(p)
            except OSError:
                continue
            if not os.path.isfile(p):
                continue
            ext = os.path.splitext(n)[1].lower()
            items.append({"dir": top, "name": n, "size": st.st_size,
                          "mtime": int(st.st_mtime), "kind": kind(ext),
                          "inline": ext in PLAIN})
    return items


def safe_path(rel):
    rel = posixpath.normpath("/" + rel).lstrip("/")
    if not rel or rel.startswith("..") or "/../" in "/" + rel:
        return None
    full = os.path.join(ROOT, rel)
    if not os.path.realpath(full).startswith(os.path.realpath(ROOT)):
        return None
    return full


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "V50Share/1.0"

    def log_message(self, fmt, *a):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % a))

    def _send(self, code, body, ctype, extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_HEAD(self):
        self.do_GET()

    def do_DELETE(self):
        """删除文件：DELETE /f/<目录>/<文件名>"""
        try:
            self.route_delete()
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as exc:  # noqa: BLE001
            try:
                self._send(500, str(exc).encode(), "text/plain; charset=utf-8")
            except Exception:
                pass

    def route_delete(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = 0
        if n:
            try:
                self.rfile.read(n)
            except Exception:
                pass
        path = unquote(urlparse(self.path).path)
        if not path.startswith("/f/"):
            return self._send(404, b"not found", "text/plain")
        rel = path[3:]
        full = safe_path(rel)
        if not full or rel.count("/") != 1:
            return self._send(403, "路径不允许".encode(), "text/plain; charset=utf-8")
        if not os.path.isfile(full):
            return self._send(404, "文件不存在".encode(), "text/plain; charset=utf-8")
        try:
            os.unlink(full)
        except OSError as exc:
            return self._send(500, str(exc).encode(), "text/plain; charset=utf-8")
        body = json.dumps({"ok": True, "name": rel}, ensure_ascii=False).encode()
        self._send(200, body, "application/json; charset=utf-8")

    def do_PUT(self):
        """浏览器直传：PUT /u/<目录>/<文件名>，body 即文件内容。"""
        try:
            self.route_put()
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as exc:  # noqa: BLE001
            try:
                self._send(500, str(exc).encode(), "text/plain; charset=utf-8")
            except Exception:
                pass

    def route_put(self):
        path = unquote(urlparse(self.path).path)
        if not path.startswith("/u/"):
            return self._send(404, b"not found", "text/plain")
        rel = path[3:]
        full = safe_path(rel)
        if not full or rel.count("/") != 1:
            return self._send(403, "路径不允许".encode(), "text/plain; charset=utf-8")
        try:
            total = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            total = 0
        os.makedirs(os.path.dirname(full), exist_ok=True)
        tmp = full + ".part"
        got = 0
        with open(tmp, "wb") as f:
            while got < total:
                chunk = self.rfile.read(min(262144, total - got))
                if not chunk:
                    break
                f.write(chunk)
                got += len(chunk)
        if got != total:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            return self._send(400, "上传中断".encode(), "text/plain; charset=utf-8")
        os.replace(tmp, full)
        try:
            os.chmod(full, 0o666)
        except OSError:
            pass
        body = json.dumps({"ok": True, "name": rel, "size": got},
                          ensure_ascii=False).encode()
        self._send(200, body, "application/json; charset=utf-8")

    def do_GET(self):
        try:
            self.route()
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as exc:  # noqa: BLE001
            try:
                self._send(500, str(exc).encode(), "text/plain; charset=utf-8")
            except Exception:
                pass

    def route(self):
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        query = parsed.query or ""

        if path in ("/", "/index.html"):
            try:
                with open(PAGE, "rb") as f:
                    body = f.read()
            except OSError:
                body = b"<h1>page missing</h1>"
                return self._send(500, body, "text/html; charset=utf-8")
            return self._send(200, body, "text/html; charset=utf-8")

        if path == "/api/list":
            body = json.dumps({"root": ROOT, "now": int(time.time()),
                               "items": listing()}, ensure_ascii=False).encode()
            return self._send(200, body, "application/json; charset=utf-8")

        if path.startswith("/f/"):
            return self.serve_file(path[3:], "dl=1" in query)

        return self._send(404, b"not found", "text/plain")

    def serve_file(self, rel, as_attachment=False):
        full = safe_path(rel)
        if not full or not os.path.isfile(full):
            return self._send(404, b"not found", "text/plain")
        size = os.path.getsize(full)
        ctype = MIME.get(os.path.splitext(full)[1].lower(), "application/octet-stream")

        rng = self.headers.get("Range")
        start, end = 0, size - 1
        partial = False
        if rng and rng.startswith("bytes="):
            spec = rng[6:].split(",")[0].strip()
            try:
                a, _, b = spec.partition("-")
                if a == "":
                    start = max(0, size - int(b))
                else:
                    start = int(a)
                    if b:
                        end = min(size - 1, int(b))
                if start > end or start >= size:
                    self.send_response(416)
                    self.send_header("Content-Range", "bytes */%d" % size)
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                partial = True
            except ValueError:
                start, end, partial = 0, size - 1, False

        length = end - start + 1
        self.send_response(206 if partial else 200)
        self.send_header("Content-Type", ctype)
        if as_attachment:
            fn = os.path.basename(full)
            self.send_header(
                "Content-Disposition",
                "attachment; filename=\"%s\"; filename*=UTF-8''%s"
                % (fn.encode("ascii", "replace").decode(), quote(fn, safe="")))
            self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(length))
        self.send_header("Accept-Ranges", "bytes")
        if partial:
            self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
        if not as_attachment:
            self.send_header("Cache-Control", "max-age=60")
        self.end_headers()
        if self.command == "HEAD":
            return

        with open(full, "rb") as f:
            f.seek(start)
            left = length
            while left > 0:
                chunk = f.read(min(262144, left))
                if not chunk:
                    break
                self.wfile.write(chunk)
                left -= len(chunk)


def main():
    if PORT_TLS and CERT and KEY and os.path.exists(CERT) and os.path.exists(KEY):
        import ssl
        import threading
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(CERT, KEY)
        tls = ThreadingHTTPServer(("0.0.0.0", PORT_TLS), H)
        tls.daemon_threads = True
        tls.socket = ctx.wrap_socket(tls.socket, server_side=True)
        threading.Thread(target=tls.serve_forever, daemon=True).start()
        sys.stderr.write("share-web listening on :%d (https), root=%s\n" % (PORT_TLS, ROOT))
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), H)
    srv.daemon_threads = True
    sys.stderr.write("share-web listening on :%d, root=%s\n" % (PORT, ROOT))
    srv.serve_forever()


if __name__ == "__main__":
    main()
